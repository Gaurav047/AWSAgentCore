# --- Bedrock -----------------------------------------------------------------
AWS_REGION=us-east-1
# Model ID or inference-profile ID enabled in your account (check the Bedrock console).
BEDROCK_MODEL_ID=anthropic.claude-opus-5
BEDROCK_MAX_TOKENS=16000

# --- Domain ------------------------------------------------------------------
# Timezone the clinic's working hours are expressed in.
APP_TIMEZONE=Asia/Kolkata
# sqlite (local) | dynamodb (required once services run in separate AgentCore containers)
STORAGE_BACKEND=sqlite
SQLITE_PATH=appointments.db
DYNAMODB_TABLE=appointments

# --- Service endpoints (local defaults) --------------------------------------
# Port the MCP server listens on. If you change it, update MCP_URL to match.
MCP_PORT=8000
MCP_URL=http://localhost:8000/mcp
SCHEDULER_A2A_URL=http://localhost:9001
REMINDER_A2A_URL=http://localhost:9002
# OAuth bearer tokens when the MCP server / A2A agents run on AgentCore Runtime with JWT auth.
MCP_BEARER_TOKEN=
A2A_BEARER_TOKEN=

# --- AgentCore ---------------------------------------------------------------
# From `appointment-app create-memory`. Empty = in-process conversation memory.
AGENTCORE_MEMORY_ID=
